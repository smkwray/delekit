# Synced, non-secret source of truth.
# Edit model IDs here, then run: python tools/render_config.py

# Codex profiles are named for their models (terra/luna/sol), not for a speed or
# mode. Profile == env suffix (lower-cased) == tandy agent name, so Codex-facing
# tandy, dairy, and herd commands share one vocabulary.

# Client-facing aliases used by Claude Code agent definitions. The recognized
# Sonnet 4.6 family prefix makes Claude Code use native preflight compaction for
# these gateway subagents instead of waiting for an upstream overflow error.
DELEGATE_ALIAS_TERRA=claude-sonnet-4-6-tandy-terra
DELEGATE_ALIAS_LUNA=claude-sonnet-4-6-tandy-luna
DELEGATE_ALIAS_SOL=claude-sonnet-4-6-tandy-sol

# Native subagent naming: <prefix>-<profile>[-capability], e.g. tandy-terra,
# tandy-terra-worktree, tandy-terra-readonly.
AGENT_PREFIX=tandy

# Capability tier shown in each generated agent's description. This is the only
# signal the orchestrator always sees when choosing a profile, so keep it short
# and keep it the single source of the profile semantics (docs and the Skill
# should defer to these words). No colons: the value is an unquoted YAML scalar.
#
# The luna/terra split is drawn where the models actually differ, not by
# difficulty: luna collects evidence a checker could verify, terra decides what
# it means and certifies that nothing was missed. Long-context recall is the
# widest measured gap between them, so exhaustive audits say terra.
DELEGATE_HINT_TERRA=default tier; implementation, judgment calls, exhaustive long-context audits
DELEGATE_HINT_LUNA=fast tier; bounded checkable work — locate, extract, compare, summarize
DELEGATE_HINT_SOL=strongest tier; hard architecture, debugging, tricky reasoning

# Provider model IDs. These are intentionally centralized here.
DELEGATE_MODEL_TERRA=gpt-5.6-terra
DELEGATE_MODEL_LUNA=gpt-5.6-luna
DELEGATE_MODEL_SOL=gpt-5.6-sol

# --- Native (Anthropic-model) delegate profiles ---
# These are NOT tandy: tandy means Codex-backed, and that word is shared with
# the dairy/herd runners, which have no Anthropic profile. These agents carry no
# prefix, so the agent name IS the profile name (opus5-1m, opus5-1m-readonly,
# opus5-1m-worktree). They exist for one reason the parent cannot supply: a
# subagent at the full 1M window.
#
# The [1m] suffix is load-bearing and client-side. Claude Code renders a "(1M
# context)" picker row only for a gateway id literally ending in [1m], and it
# strips the suffix before the wire — so a bare `opus` resolves to the plain
# 200k id. Both ids must exist upstream; patches/cliproxy-claude-opus-5.patch
# clones them. Comma-separated; each name maps to DELEGATE_NATIVE_*_<NAME> with
# dashes upper-cased to underscores.
DELEGATE_NATIVE_PROFILES=opus5-1m,fable5-1m

#
# Effort here may use xhigh, which DELEGATE_EFFORT_* (the tandy/dairy/herd keys)
# still may not. The subagent clamp that rewrote xhigh to high was fixed
# upstream: measured on the wire under Claude Code 2.1.223 with the parent
# pinned to `low`, a subagent declaring xhigh sends xhigh. The tandy keys stay
# restricted because they are also passed to the backend CLIs, where the word
# means something else. Re-measure after a Claude Code upgrade.
DELEGATE_NATIVE_ALIAS_OPUS5_1M=claude-opus-5[1m]
DELEGATE_NATIVE_HINT_OPUS5_1M=Opus 5 at 1M context; deep reasoning over inputs too large for a 200k delegate
DELEGATE_NATIVE_EFFORT_OPUS5_1M=xhigh

DELEGATE_NATIVE_ALIAS_FABLE5_1M=claude-fable-5[1m]
DELEGATE_NATIVE_HINT_FABLE5_1M=Fable 5 at 1M context; fast wide-context sweeps and extraction
DELEGATE_NATIVE_EFFORT_FABLE5_1M=medium

# Antigravity (agy) profiles are backend-specific: reusing the Codex model names
# terra/luna/sol here made status and commands misleading. Agy slugs bake the
# effort tier into the name, so dairy resolves a full slug and sends no separate
# --effort. `agy models` lists valid slugs.
DELEGATE_AGY_MODEL_FLASH_HIGH=gemini-3.6-flash-high
DELEGATE_AGY_MODEL_FLASH_LOW=gemini-3.6-flash-low
DELEGATE_AGY_MODEL_PRO_HIGH=gemini-3.1-pro-high


# Reasoning effort per profile. One source for both delegation paths: the
# headless runners (dairy/herd) pass it to the backend CLI, and the rendered
# tandy agent files carry it as frontmatter `effort:`. Without the frontmatter
# a subagent silently inherits the session effort, so the two paths disagreed.
#
# All three sit at high deliberately. `xhigh` is NOT usable here: Claude Code
# clamps it to `high` on the subagent path (verified on the wire — see
# docs/known-issues.md), so writing it would render a file that reads xhigh and
# ships high. `max` costs far more for a tier sol already covers. Luna moved
# medium -> high once its price fell ~5x, which is what medium was hedging.
DELEGATE_EFFORT_TERRA=high
DELEGATE_EFFORT_LUNA=high
DELEGATE_EFFORT_SOL=high

RUNNER_DEFAULT_BACKEND=codex
RUNNER_DEFAULT_WRITE_ACCESS=workspace-write
RUNNER_DEFAULT_READ_ACCESS=read-only
RUNNER_LOG_TTL_DAYS=7

# --- CLIProxyAPI gateway (used to render generated/cliproxy/config.template.yaml) ---
CLIPROXY_HOST=127.0.0.1
CLIPROXY_PORT=8317

# Catalog display names for the three delegate aliases.
CLIPROXY_DISPLAY_TERRA=GPT 5.6 Terra
CLIPROXY_DISPLAY_LUNA=GPT 5.6 Luna
CLIPROXY_DISPLAY_SOL=GPT 5.6 Sol

# Keep the /model picker short: latest opus, latest sonnet, fable, and the three
# delegate aliases. Comma-separated; "*" wildcards are supported by CLIProxyAPI.
CLIPROXY_EXCLUDE_CLAUDE=claude-3-*,*haiku*,claude-opus-4-1-20250805,claude-opus-4-20250514,claude-opus-4-5-20251101,claude-opus-4-6,claude-opus-4-7,claude-sonnet-4-20250514,claude-sonnet-4-5-20250929,claude-sonnet-4-6
# Keep the picker to the current generation only. The *codex* wildcard also
# removes gpt-5.3-codex-spark: benchmarked as fast on the Codex harness but
# slow and erratic through this one, so it is not worth a picker slot here.
CLIPROXY_EXCLUDE_CODEX=*codex*,gpt-image-*,gpt-5.4*,gpt-5.5
