# LOCAL-ONLY. Copy to the per-device path created by the installer.
# Never store real credentials in the synced kit.

ANTHROPIC_BASE_URL=http://127.0.0.1:8317
ANTHROPIC_AUTH_TOKEN=replace-with-local-proxy-client-key
# Alternative for gateways expecting x-api-key:
# ANTHROPIC_API_KEY=replace-with-local-proxy-client-key

# Discover the stable aliases exposed by the gateway. Alias IDs intentionally
# begin with "claude-" because Claude Code filters gateway discovery by prefix.
CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1

# Recommended gateway defaults. The launchers also supply these when absent.
# Send effort for custom model aliases, omit the changing attribution block to
# improve gateway prompt-cache reuse, and load tool schemas up front unless the
# gateway has been verified to forward Anthropic tool_reference blocks.
CLAUDE_CODE_ALWAYS_ENABLE_EFFORT=1
CLAUDE_CODE_ATTRIBUTION_HEADER=0
ENABLE_TOOL_SEARCH=false

# Parent (orchestrator) model for gateway launches. STRONGLY RECOMMENDED.
# Claude Code writes a /model choice into the GLOBAL user settings file. Pick a
# delegate alias from /model inside a gateway session and every later launch
# inherits it, including direct-to-Anthropic ones, which then fail because the
# alias exists only behind the proxy. Pinning it here makes the gateway launcher
# self-consistent whatever settings.json holds. Use an ID the gateway serves --
# check /v1/models -- and pin your non-gateway launcher to its own model too.
# An explicit --model on the command line still overrides this.
#
# Context window: gateway sessions default every model to a 200k budget because
# Claude Code only knows real windows for first-party connections. Append [1m]
# to a Claude model ID to restore the 1M window. The suffix is client-side
# only -- Claude Code strips it and sends the clean ID plus the context-1m beta
# header, which CLIProxyAPI forwards. Never send a literal "model[1m]" to the
# proxy yourself; it 502s as an unknown model. Works for any 1M-capable Claude
# model (fable, opus, sonnet); verified 2026-07-21 via /context showing
# "claude-fable-5[1m] ... /1m tokens".
DELEGATE_PARENT_MODEL=claude-fable-5[1m]

# Optional per-device quota/resource guard. Claude Code currently defaults to 10.
# Set only after observing account rate limits or local contention.
# CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY=4
